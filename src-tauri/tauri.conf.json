{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "爱雅思写作 aiELTS Writing",
  "version": "2.0.0",
  "identifier": "com.local.ieltswriting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "爱雅思写作 aiELTS Writing",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/questions/*"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
